# Messaging a background agent through the agent list (Chat's message box over a subagent's
# conversation). First recorded 2026-11-28 (run 20261128-122040, Claude Code 2.1.332): the
# screens are Chat's `agent_message_*` fixtures. `back_closed` and the agent's end are not
# recorded yet.

[idle]
kind = idle
agents = input

[before_transcript]
prompts = Use the Agent tool once* Then reply only with the word started.

[list]
agents = select · main

[highlighted]
agents = stop · general-purpose Count slowly

# The agent shows: its input's dim placeholder names it, and the list keeps the keys on it.
[viewing]
viewing = general-purpose
agents = select · general-purpose Count slowly

[viewing_later]
viewing = general-purpose

[typed]
input = Reply with the word kilo when you are done.

# Sent: the agent holds it until its next step ("· 1 queued" on its row).
[sent]
viewing = general-purpose
agents = input
shows = 1 queued

# Not on disk yet: the main transcript has only the first prompt, the agent's only its task.
[sent_transcript]
prompts = Use the Agent tool once* Then reply only with the word started.
agent-prompts = Run the Bash command ping*
agents = general-purpose: Count slowly: -

[back_list]
agents = select · main

# Main shows again; the list keeps the keys on it.
[back]
viewing = -
agents = select · main

# One Esc from the list on main: the input has the keys again.
[back_closed]
viewing = -
agents = input

[ended]
shows = Agent "Count slowly" finished

# Handed in at the agent's next step, the message is in the agent's own transcript (a
# `queued_command` without `commandMode`), never in the main session's.
[ended_transcript]
agents = general-purpose: Count slowly: Finished from Notification
agent-prompts = Run the Bash command ping* | Reply with the word kilo when you are done.
prompts = Use the Agent tool once* Then reply only with the word started.
