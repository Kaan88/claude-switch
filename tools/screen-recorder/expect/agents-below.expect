# The list of agents under the input's bottom rule is no part of the input.
[agents]
kind = idle
input =
send = yes
working = no

[agents_later]
kind = idle
input =
send = yes
working = no
# Only the list under the rule redrew between the two: the rows down to it are the same, so the
# screen goes quiet (Chat's activity digest).
activity = agents
