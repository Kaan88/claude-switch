# Recorded from Claude Code 2.1.332 (Haiku) on 2026-11-28. `side` says whether the preview box
# was found beside the choices; every other screen key is read without it, as Chat reads the
# question. With previews there is no "Type something" row, and "Chat about this" has no number.

[asked]
kind = question
title = Which layout do you prefer?
choices = Boxed | Tree | Plain | Chat about this
highlight = Boxed
side = yes
esc = yes
send = no

[asked_transcript]
# Whether the transcript holds the call while the question waits differs from run to run (two
# tries of the first recording: once it did, once not). Chat uses the call's card whenever the
# call is there and the screen's menu card otherwise, so either is fine here.
asked = - || Layout (2 previews, 0 multi-select, running)

[second]
kind = question
highlight = Tree
side = yes

[third]
# "Plain" has no preview: the box says "No preview available".
kind = question
highlight = Plain
side = yes

[chat_about]
# Recorded 2026-11-28: one Down below the last option highlights "Chat about this", and the
# last option keeps its own mark in the same colours; the mark on "Chat about this" wins.
kind = question
highlight = Chat about this

[back]
kind = question
highlight = Tree

[answered]
kind = idle
send = yes
working = no

[answered_transcript]
asked = Layout (2 previews, 0 multi-select, ok)
