# What Chat reads from scripts/queued-text.txt. The keys are explained in the README and in
# bins/claude-switch/src/view/chat/question/screens/compat.rs.
# The text on the input while the turn runs: Chat writes Enter only once it reads it back.
[typed]
kind = working
input = Also reply with the word echo.

# After Enter the input reads empty again and the turn still runs: the next one goes in at once.
[one_sent]
kind = working
input =
working = yes

[lines_typed]
kind = working
lines = Then reply with the word foxtrot.\nOn one line.

[two_sent]
kind = working
input =
working = yes

# A long line shows as Claude Code's paste marker ("[Pasted text #1]"); Chat's echo check
# takes it.
[long_typed]
kind = working
sent = Finally reply with the word golf. These words are here only to make the message long: one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, one two three four five six seven eight nine ten, the end.

[long_sent]
kind = working
input =
working = yes

[after]
kind = idle
send = yes

# All are recorded as messages during the turn, which starts no other. The long one is
# recorded inside <pasted_content> tags, which the reader takes out.
[transcript]
prompts = Run exactly this with the Bash tool and nothing else: ping -n 26 127.0.0.1 | Also reply with the word echo. (during a turn) | Then reply with the word foxtrot. On one line. (during a turn) | Finally reply with the word golf. * the end. (during a turn)
turn = Run exactly this with the Bash tool and nothing else: ping -n 26 127.0.0.1
