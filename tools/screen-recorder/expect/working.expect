[working]
kind = working
input =
send = no
# The terminal card's rows start at the call, whether its bullet (`●`, `⏺`) is lit or not:
# a running call's bullet blinks.
card = call: Bash(ping -n 26 127.0.0.1)*

# The hint row drops "esc to interrupt" while the input holds text: the working line says it.
[working_typed]
kind = working
input = hello while busy
send = no

[interrupted]
kind = idle
input =
send = yes
working = no

[restored]
kind = input
input = Reply with just the word: pong
send = no
working = no
